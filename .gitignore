# Safety first: this repo becomes a PUBLIC website, so nothing but the page may ever live here.
# Keys, logs, state files and trade history stay in D:\claude-workspace\trading and are never copied in.
*.env
*.key
*.csv
*.json
*.log
*.py

# The site needs this one small file, so it is allowed through the rule above.
!_routes.json
# The special bots' practice numbers (written by the trading session's publish step; numbers only, never keys).
!special/data/*.json

# Build notes for me, not for the website.
LOGIN_BUILD.md

# Local testing leftovers - never part of the website.
node_modules/
.wrangler/
