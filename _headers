# Rules Cloudflare applies to every page it serves. Nothing secret here - these are safety switches.

/*
  # Nobody may put this site inside a hidden frame on their own page to trick a visitor.
  X-Frame-Options: DENY
  # Other sites cannot reach into this site's windows. "allow-popups" keeps Google's sign-in popup working.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # This site's files may only be pulled into pages on this site, not embedded by other websites.
  Cross-Origin-Resource-Policy: same-origin
  # A file is treated as what it says it is, so a picture can never be run as code.
  X-Content-Type-Options: nosniff
  # Other sites are told which page a visitor came from, but never the full address of a private page.
  Referrer-Policy: strict-origin-when-cross-origin
  # The site never asks for a camera, a microphone or a location, so those are switched off outright.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Browsers must always use the secure connection for this site, for the next two years.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # The page may only load its own files, its fonts from Google, prices from Binance's public feed,
  # and Google's own sign-in button (its script, its small window, and your Google profile picture).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://data-api.binance.vision https://fapi.binance.com wss://fstream.binance.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Pictures and icons barely change, so browsers may keep them for a year.
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

# The shared look and the small scripts change whenever the site does, so the browser must always
# ask whether its copy is still the newest. The answer is a few bytes when nothing has changed.
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Anything private must never be kept in a shared cache.
/profile/*
  Cache-Control: private, no-store
/trading/*
  Cache-Control: private, no-store
